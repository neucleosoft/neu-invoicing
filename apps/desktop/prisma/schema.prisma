// Prisma schema for Neu Invoicing

generator client {
  provider = "prisma-client-js"
  // Force the generated client into a real folder under apps/desktop/node_modules,
  // not pnpm's virtual store at node_modules/.pnpm/@prisma+client@*/.../.prisma/client.
  // Without this, electron-builder's `node_modules/.prisma/**/*` rule finds nothing to
  // bundle and the installed app errors with "Cannot find module '.prisma/client/default'".
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Company Information (Singleton - only one record)
model Company {
  id              String   @id @default(cuid())
  name            String
  address         String
  phone           String?
  email           String?
  taxId           String? // GSTIN, VAT, etc.
  logoPath        String?
  signaturePath   String?
  fiscalYearStart Int      @default(4) // Month (1-12), default April
  currency        String   @default("USD")
  invoicePrefix   String   @default("INV")
  termsConditions String?
  bankDetails     String?
  // GST-specific fields
  stateCode       String? // 2-digit state code (e.g., "27" for Maharashtra)
  stateName       String? // State name
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Customers (sales-side parties — was "Party" with type=CUSTOMER)
// DB table is still "Party" via @@map; suppliers moved to separate Supplier table.
model Customer {
  deletedAt       DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id              String    @id @default(cuid())
  name            String
  type            String // legacy field — always "CUSTOMER" after Supplier split
  phone           String?
  email           String?
  billingAddress  String?
  shippingAddress String?
  taxId           String? // GSTIN
  openingBalance  Float     @default(0)
  currentBalance  Float     @default(0)
  // GST-specific fields
  stateCode       String? // 2-digit state code
  stateName       String? // State name
  gstType         String    @default("REGULAR") // REGULAR, COMPOSITION, UNREGISTERED, CONSUMER, SEZ, DEEMED_EXPORT
  // Additional GST lookup fields
  legalName       String? // Official registered name from GST
  tradeName       String? // Trade name from GST
  gstStatus       String? // Active, Cancelled, Suspended
  city            String?
  district        String?
  pincode         String?
  fetchedFromGst  Boolean   @default(false)
  lastGstFetch    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations (sales-side documents only — purchases use Supplier)
  salesInvoices    SalesInvoice[]
  quotations       Quotation[]
  proformaInvoices ProformaInvoice[]
  payments         PaymentTransaction[]
  deliveryChallans DeliveryChallan[]
  creditDebitNotes CreditDebitNote[]

  @@map("Party")
}

// Suppliers (purchase-side parties — own table, separate from Customer)
model Supplier {
  deletedAt       DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id              String    @id @default(cuid())
  name            String
  phone           String?
  email           String?
  billingAddress  String?
  shippingAddress String?
  taxId           String? // GSTIN
  openingBalance  Float     @default(0)
  currentBalance  Float     @default(0) // amount we owe this supplier
  // GST-specific fields
  stateCode       String?
  stateName       String?
  gstType         String    @default("REGULAR")
  // Additional GST lookup fields
  legalName       String?
  tradeName       String?
  gstStatus       String?
  city            String?
  district        String?
  pincode         String?
  fetchedFromGst  Boolean   @default(false)
  lastGstFetch    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  purchaseBills  PurchaseBill[]
  purchaseOrders PurchaseOrder[]
  supplierItems  SupplierItem[]
  payments       PaymentTransaction[]
}

// Catalog of items each supplier sells YOU (separate from your sellable Item catalog).
// Created on-the-fly by AI extraction; can optionally link back to Item for stock tracking.
model SupplierItem {
  deletedAt         DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id                String    @id @default(cuid())
  supplierId        String
  supplier          Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name              String
  hsnCode           String?
  unit              String    @default("pcs")
  lastPurchasePrice Float     @default(0)
  defaultTaxRate    Float     @default(0)
  // Optional link to your sellable Item — only set when a purchased item is also a sellable item
  linkedItemId      String?
  linkedItem        Item?     @relation(fields: [linkedItemId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  purchaseBillItems  PurchaseBillItem[]
  purchaseOrderItems PurchaseOrderItem[]
}

// Items (Products and Services)
model Item {
  deletedAt       DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id              String    @id @default(cuid())
  name            String
  skuHsn          String? // SKU code
  hsnCode         String? // HSN/SAC code for GST
  type            String    @default("PRODUCT") // PRODUCT or SERVICE
  unit            String    @default("pcs") // pcs, kg, hrs, etc.
  salePrice       Float     @default(0)
  purchasePrice   Float     @default(0)
  taxRate         Float     @default(0) // Total GST percentage (e.g., 18 for 18% GST)
  // GST tax type
  gstType         String    @default("GST") // GST, EXEMPT, NIL_RATED, NON_GST
  trackStock      Boolean   @default(false)
  currentStock    Float     @default(0)
  openingStock    Float     @default(0) // stock before any recorded movement — lets recompute rebuild currentStock = openingStock + Σ(stockMovements), mirroring party openingBalance
  lowStockWarning Float     @default(10)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  salesInvoiceItems    SalesInvoiceItem[]
  quotationItems       QuotationItem[]
  proformaInvoiceItems ProformaInvoiceItem[]
  // Note: PurchaseBillItem now references SupplierItem; Item is reachable through SupplierItem.linkedItem.
  supplierItems        SupplierItem[]
  stockMovements       StockMovement[]
  deliveryChallanItems DeliveryChallanItem[]
  creditDebitNoteItems CreditDebitNoteItem[]
}

// Sales Invoices
model SalesInvoice {
  deletedAt                DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  cancelledAt              DateTime? // cancel/void (Mode B): null = live, timestamp = cancelled-at-then (terminal, never restored)
  cancelReason             String? // optional free-text reason for the cancellation
  id                       String           @id @default(cuid())
  invoiceNumber            String           @unique
  invoiceDate              DateTime         @default(now())
  dueDate                  DateTime?
  type                     String           @default("INVOICE") // INVOICE
  customerId               String           @map("partyId")
  customer                 Customer         @relation(fields: [customerId], references: [id])
  subtotal                 Float            @default(0)
  discount                 Float            @default(0)
  taxAmount                Float            @default(0)
  totalAmount              Float            @default(0)
  amountPaid               Float            @default(0)
  balanceDue               Float            @default(0)
  status                   String           @default("DRAFT") // DRAFT, PAID, PARTIAL, OVERDUE
  convertedFromQuotationId String?
  convertedQuotation       Quotation?       @relation("QuotationConversion", fields: [convertedFromQuotationId], references: [id], onDelete: SetNull)
  convertedFromProformaId  String?
  convertedProforma        ProformaInvoice? @relation("ProformaConversion", fields: [convertedFromProformaId], references: [id], onDelete: SetNull)
  notes                    String?
  termsConditions          String?
  // GST-specific fields
  placeOfSupply            String? // State code of place of supply
  placeOfSupplyName        String? // State name of place of supply
  isInterState             Boolean          @default(false) // true = IGST, false = CGST+SGST
  reverseCharge            Boolean          @default(false) // Reverse charge mechanism
  cgstAmount               Float            @default(0)
  sgstAmount               Float            @default(0)
  igstAmount               Float            @default(0)
  cessAmount               Float            @default(0)
  // Supply type for GSTR classification
  supplyType               String           @default("B2B") // B2B, B2C_LARGE, B2C_SMALL, EXPORT, NIL_EXEMPT
  ecommerceGstin           String? // E-commerce operator GSTIN if applicable
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  // Additional fields (all optional)
  poNumber          String?
  ewayBillNo        String?
  vehicleNumber     String?
  warrantyPeriod    String?
  dispatchedThrough String?
  // Relations
  items             SalesInvoiceItem[]
  payments          PaymentTransaction[]
  creditDebitNotes  CreditDebitNote[]
}

// Line items for sales invoices
model SalesInvoiceItem {
  id             String       @id @default(cuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  quantity       Float
  rate           Float
  discount       Float        @default(0)
  taxRate        Float        @default(0)
  total          Float
  // GST-specific fields
  hsnCode        String?
  taxableAmount  Float        @default(0)
  cgstRate       Float        @default(0)
  cgstAmount     Float        @default(0)
  sgstRate       Float        @default(0)
  sgstAmount     Float        @default(0)
  igstRate       Float        @default(0)
  igstAmount     Float        @default(0)
  cessRate       Float        @default(0)
  cessAmount     Float        @default(0)
  createdAt      DateTime     @default(now())
}

// Quotations
model Quotation {
  deletedAt         DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id                String    @id @default(cuid())
  invoiceNumber     String    @unique
  invoiceDate       DateTime  @default(now())
  dueDate           DateTime?
  customerId        String    @map("partyId")
  customer          Customer  @relation(fields: [customerId], references: [id])
  subtotal          Float     @default(0)
  discount          Float     @default(0)
  taxAmount         Float     @default(0)
  totalAmount       Float     @default(0)
  status            String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  notes             String?
  termsConditions   String?
  placeOfSupply     String?
  placeOfSupplyName String?
  isInterState      Boolean   @default(false)
  reverseCharge     Boolean   @default(false)
  cgstAmount        Float     @default(0)
  sgstAmount        Float     @default(0)
  igstAmount        Float     @default(0)
  cessAmount        Float     @default(0)
  supplyType        String    @default("B2B")
  ecommerceGstin    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deliveryTime      DateTime?

  items             QuotationItem[]
  convertedInvoices SalesInvoice[]  @relation("QuotationConversion")
}

model QuotationItem {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item      @relation(fields: [itemId], references: [id])
  quantity      Float
  rate          Float
  discount      Float     @default(0)
  taxRate       Float     @default(0)
  total         Float
  hsnCode       String?
  taxableAmount Float     @default(0)
  cgstRate      Float     @default(0)
  cgstAmount    Float     @default(0)
  sgstRate      Float     @default(0)
  sgstAmount    Float     @default(0)
  igstRate      Float     @default(0)
  igstAmount    Float     @default(0)
  cessRate      Float     @default(0)
  cessAmount    Float     @default(0)
  createdAt     DateTime  @default(now())
}

// Proforma Invoices
model ProformaInvoice {
  deletedAt         DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id                String    @id @default(cuid())
  invoiceNumber     String    @unique
  invoiceDate       DateTime  @default(now())
  dueDate           DateTime?
  customerId        String    @map("partyId")
  customer          Customer  @relation(fields: [customerId], references: [id])
  subtotal          Float     @default(0)
  discount          Float     @default(0)
  taxAmount         Float     @default(0)
  totalAmount       Float     @default(0)
  status            String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  notes             String?
  termsConditions   String?
  placeOfSupply     String?
  placeOfSupplyName String?
  isInterState      Boolean   @default(false)
  reverseCharge     Boolean   @default(false)
  cgstAmount        Float     @default(0)
  sgstAmount        Float     @default(0)
  igstAmount        Float     @default(0)
  cessAmount        Float     @default(0)
  supplyType        String    @default("B2B")
  ecommerceGstin    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deliveryTime      DateTime?

  items             ProformaInvoiceItem[]
  convertedInvoices SalesInvoice[]        @relation("ProformaConversion")
}

model ProformaInvoiceItem {
  id                String          @id @default(cuid())
  proformaInvoiceId String
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  quantity          Float
  rate              Float
  discount          Float           @default(0)
  taxRate           Float           @default(0)
  total             Float
  hsnCode           String?
  taxableAmount     Float           @default(0)
  cgstRate          Float           @default(0)
  cgstAmount        Float           @default(0)
  sgstRate          Float           @default(0)
  sgstAmount        Float           @default(0)
  igstRate          Float           @default(0)
  igstAmount        Float           @default(0)
  cessRate          Float           @default(0)
  cessAmount        Float           @default(0)
  createdAt         DateTime        @default(now())
}

// Purchase Bills
model PurchaseBill {
  deletedAt             DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  cancelledAt           DateTime? // cancel/void (Mode B): null = live, timestamp = cancelled-at-then (terminal, never restored)
  cancelReason          String? // optional free-text reason for the cancellation
  id                    String         @id @default(cuid())
  billNumber            String         @unique
  billDate              DateTime       @default(now())
  supplierId            String
  supplier              Supplier       @relation(fields: [supplierId], references: [id])
  subtotal              Float          @default(0)
  discount              Float          @default(0)
  taxAmount             Float          @default(0)
  totalAmount           Float          @default(0)
  amountPaid            Float          @default(0)
  balanceDue            Float          @default(0)
  status                String         @default("DRAFT") // DRAFT, PAID, PARTIAL, OVERDUE
  notes                 String?
  // GST-specific fields
  placeOfSupply         String? // State code of place of supply
  placeOfSupplyName     String? // State name
  isInterState          Boolean        @default(false)
  reverseCharge         Boolean        @default(false)
  cgstAmount            Float          @default(0)
  sgstAmount            Float          @default(0)
  igstAmount            Float          @default(0)
  cessAmount            Float          @default(0)
  supplierInvoiceNumber String? // Supplier's invoice number
  supplierInvoiceDate   DateTime? // Supplier's invoice date
  itcEligibility        String         @default("ELIGIBLE") // ELIGIBLE, INELIGIBLE, PARTIAL
  // Attachment — original bill image/PDF uploaded by user (used for AI extraction + audit trail)
  attachmentData        Bytes? // raw file bytes (BLOB), null when no attachment
  attachmentMimeType    String? // e.g., "image/jpeg", "image/png", "application/pdf"
  // Optional link back to the Purchase Order this bill satisfies. Bills can exist
  // without a PO (cash purchases, walk-in suppliers); when set, the PO can be
  // closed once it's fully invoiced. SetNull on PO delete keeps the bill standalone.
  purchaseOrderId       String?
  purchaseOrder         PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  items    PurchaseBillItem[]
  payments PaymentTransaction[]
}

// Purchase Orders — sent to suppliers BEFORE goods/services are received.
// A PO records what you ORDERED. The actual financial obligation lives on the
// PurchaseBill the supplier sends back; bills reference their originating PO via
// PurchaseBill.purchaseOrderId. PO doesn't affect stock or balances by itself.
model PurchaseOrder {
  deletedAt          DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id                 String    @id @default(cuid())
  orderNumber        String    @unique
  orderDate          DateTime  @default(now())
  expectedDate       DateTime?
  supplierId         String
  supplier           Supplier  @relation(fields: [supplierId], references: [id])
  // Captured per-PO so they can override the company default for this order.
  // billingAddress = where supplier should send their invoice; shippingAddress = where
  // goods should be delivered. They're often different (HQ vs warehouse).
  billingAddress     String?
  shippingAddress    String?
  // Free-text reference to the supplier's earlier quotation, e.g. "QUOT-2026-042 02.03.2026".
  vendorQuotationRef String?
  subtotal           Float     @default(0)
  discount           Float     @default(0)
  taxAmount          Float     @default(0)
  totalAmount        Float     @default(0)
  status             String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, PARTIALLY_RECEIVED, RECEIVED, CLOSED, CANCELLED
  notes              String?
  termsConditions    String?
  // GST fields (mirrors PurchaseBill so PDF rendering shares the same input shape)
  placeOfSupply      String?
  placeOfSupplyName  String?
  isInterState       Boolean   @default(false)
  cgstAmount         Float     @default(0)
  sgstAmount         Float     @default(0)
  igstAmount         Float     @default(0)
  cessAmount         Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items PurchaseOrderItem[]
  // Bills issued against this PO. A PO can have multiple bills if deliveries are split.
  bills PurchaseBill[]
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierItemId   String
  supplierItem     SupplierItem  @relation(fields: [supplierItemId], references: [id])
  quantity         Float
  // How many units have actually been received against this line so far. Set during the
  // "Mark Received" flow; PO header status derives from comparing receivedQuantity to
  // quantity across all lines: none → SENT/ACCEPTED, some → PARTIALLY_RECEIVED, all → RECEIVED.
  receivedQuantity Float         @default(0)
  rate             Float
  discount         Float         @default(0)
  taxRate          Float         @default(0)
  total            Float
  hsnCode          String?
  taxableAmount    Float         @default(0)
  cgstRate         Float         @default(0)
  cgstAmount       Float         @default(0)
  sgstRate         Float         @default(0)
  sgstAmount       Float         @default(0)
  igstRate         Float         @default(0)
  igstAmount       Float         @default(0)
  createdAt        DateTime      @default(now())
}

// Line items for purchase bills
model PurchaseBillItem {
  id             String       @id @default(cuid())
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  supplierItemId String
  supplierItem   SupplierItem @relation(fields: [supplierItemId], references: [id])
  quantity       Float
  rate           Float
  discount       Float        @default(0)
  taxRate        Float        @default(0)
  total          Float
  // GST-specific fields
  hsnCode        String?
  taxableAmount  Float        @default(0)
  cgstRate       Float        @default(0)
  cgstAmount     Float        @default(0)
  sgstRate       Float        @default(0)
  sgstAmount     Float        @default(0)
  igstRate       Float        @default(0)
  igstAmount     Float        @default(0)
  cessRate       Float        @default(0)
  cessAmount     Float        @default(0)
  createdAt      DateTime     @default(now())
}

// Payment Transactions (Payment In and Payment Out)
model PaymentTransaction {
  deletedAt      DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  cancelledAt    DateTime? // cancel/void (Mode B): null = live, timestamp = cancelled-at-then (terminal, never restored)
  cancelReason   String? // optional free-text reason for the cancellation
  id             String        @id @default(cuid())
  type           String // PAYMENT_IN or PAYMENT_OUT
  customerId     String?       @map("partyId")
  customer       Customer?     @relation(fields: [customerId], references: [id])
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  amount         Float
  paymentMode    String        @default("CASH") // CASH, BANK_TRANSFER, CARD, CHEQUE, UPI, OTHER
  paymentDate    DateTime      @default(now())
  referenceType  String? // INVOICE, BILL, or ADVANCE
  referenceId    String? // ID of the invoice or bill (deprecated, use salesInvoiceId or purchaseBillId)
  salesInvoiceId String?
  salesInvoice   SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  purchaseBillId String?
  purchaseBill   PurchaseBill? @relation(fields: [purchaseBillId], references: [id])
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?     @updatedAt // nullable: SQLite ADD COLUMN can't take now(); legacy rows backfilled to createdAt. Needed so payment edits can sync newest-wins.
}

// Stock Movement Audit Log
model StockMovement {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  movementType  String // SALE, PURCHASE, ADJUSTMENT
  quantity      Float // Positive for IN, Negative for OUT
  referenceType String? // "INVOICE", "BILL", "ADJUSTMENT"
  referenceId   String?
  notes         String?
  createdAt     DateTime @default(now())
}

// Sync Metadata
model SyncMetadata {
  id                    String    @id @default(cuid())
  lastSyncTimestamp     DateTime  @default(now())
  deviceId              String
  syncStatus            String    @default("idle") // idle, syncing, error
  cloudFileModifiedTime DateTime?
  lastError             String?
  updatedAt             DateTime  @updatedAt
}

// User Settings
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Delivery Challan (goods dispatch without invoice)
model DeliveryChallan {
  deletedAt            DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  cancelledAt          DateTime? // cancel/void (Mode B): null = live, timestamp = cancelled-at-then (terminal, never restored)
  cancelReason         String? // optional free-text reason for the cancellation
  id                   String                @id @default(cuid())
  challanNumber        String                @unique
  challanDate          DateTime              @default(now())
  customerId           String                @map("partyId")
  customer             Customer              @relation(fields: [customerId], references: [id])
  subtotal             Float                 @default(0)
  taxAmount            Float                 @default(0)
  totalAmount          Float                 @default(0)
  transportMode        String?
  vehicleNumber        String?
  notes                String?
  termsConditions      String?
  status               String                @default("NON_RETURNABLE") // RETURNABLE, NON_RETURNABLE, CONVERTED
  convertedToInvoiceId String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  // Additional fields (all optional)
  poNumber             String?
  ewayBillNo           String?
  warrantyPeriod       String?
  dispatchedThrough    String?
  items                DeliveryChallanItem[]
}

model DeliveryChallanItem {
  id                String          @id @default(cuid())
  deliveryChallanId String
  deliveryChallan   DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  quantity          Float
  rate              Float
  taxRate           Float           @default(0)
  discount          Float           @default(0)
  total             Float
  hsnCode           String?
  createdAt         DateTime        @default(now())
}

// Credit and Debit Notes (for returns / adjustments)
model CreditDebitNote {
  deletedAt          DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  cancelledAt        DateTime? // cancel/void (Mode B): null = live, timestamp = cancelled-at-then (terminal, never restored)
  cancelReason       String? // optional free-text reason for the cancellation
  id                 String                @id @default(cuid())
  noteNumber         String                @unique
  noteDate           DateTime              @default(now())
  type               String // CREDIT_NOTE or DEBIT_NOTE
  customerId         String                @map("partyId")
  customer           Customer              @relation(fields: [customerId], references: [id])
  referenceInvoiceId String?
  referenceInvoice   SalesInvoice?         @relation(fields: [referenceInvoiceId], references: [id])
  reason             String?
  subtotal           Float                 @default(0)
  taxAmount          Float                 @default(0)
  totalAmount        Float                 @default(0)
  cgstAmount         Float                 @default(0)
  sgstAmount         Float                 @default(0)
  igstAmount         Float                 @default(0)
  isInterState       Boolean               @default(false)
  status             String                @default("ACTIVE") // ACTIVE, CANCELLED
  notes              String?
  termsConditions    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  items              CreditDebitNoteItem[]
}

model CreditDebitNoteItem {
  id                String          @id @default(cuid())
  creditDebitNoteId String
  creditDebitNote   CreditDebitNote @relation(fields: [creditDebitNoteId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  quantity          Float
  rate              Float
  discount          Float           @default(0)
  taxRate           Float           @default(0)
  total             Float
  hsnCode           String?
  taxableAmount     Float           @default(0)
  cgstRate          Float           @default(0)
  cgstAmount        Float           @default(0)
  sgstRate          Float           @default(0)
  sgstAmount        Float           @default(0)
  igstRate          Float           @default(0)
  igstAmount        Float           @default(0)
  createdAt         DateTime        @default(now())
}

// Cash & Bank Accounts
model BankAccount {
  deletedAt      DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id             String    @id @default(cuid())
  name           String
  type           String // CASH or BANK
  accountNumber  String?
  bankName       String?
  ifscCode       String?
  currentBalance Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// GST Lookup Cache - Stores fetched GST details to minimize API calls
model GstCache {
  id                  String   @id @default(cuid())
  gstin               String   @unique
  tradeName           String?
  legalName           String?
  gstStatus           String? // Active, Cancelled, Suspended
  registrationDate    String?
  businessType        String?
  // Principal Address
  addressLine1        String?
  addressLine2        String?
  city                String?
  district            String?
  state               String?
  stateCode           String?
  pincode             String?
  // Raw response for additional addresses
  additionalAddresses String? // JSON stringified array
  rawResponse         String? // Full API response as JSON
  fetchedAt           DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// User-uploaded archive of older invoices issued before this app was adopted
// (paper bills, exports from prior software, scans, etc.). Each row carries
// the original file as a BLOB so it ships through the existing full-file
// SQLite → Drive backup with no extra plumbing.
model PreviousInvoice {
  deletedAt     DateTime? // soft-delete (sync R8): null = live, timestamp = deleted-at-then
  id            String                @id @default(cuid())
  // Sequential, app-assigned counter independent of invoiceNumber. Lets the UI
  // count and sort archive rows even when invoice numbers collide across
  // fiscal years (e.g. "146" in 24-25 and "146" in 25-26 are different rows
  // with different serial numbers). Nullable so the column add is migration-
  // safe; ensureTablesExist() backfills any null rows on next launch, and the
  // handler always assigns a value on create.
  serialNumber  Int?                  @unique
  invoiceNumber String
  invoiceDate   DateTime
  partyName     String
  partyGstin    String?
  totalAmount   Float
  notes         String?
  fileData      Bytes // raw file bytes (PDF / image / spreadsheet)
  fileMimeType  String
  fileName      String
  items         PreviousInvoiceItem[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

// Structured line items extracted from the uploaded invoice. Populated at
// upload time by the extractor so Excel/CSV downloads (and any future
// reporting) can read pre-parsed rows without re-cracking the PDF on every
// request. Cascade on delete: removing the parent PreviousInvoice wipes its
// items too, no orphans.
model PreviousInvoiceItem {
  id                String          @id @default(cuid())
  previousInvoiceId String
  previousInvoice   PreviousInvoice @relation(fields: [previousInvoiceId], references: [id], onDelete: Cascade)
  name              String
  hsnCode           String?
  quantity          Float
  unit              String?
  rate              Float
  discount          Float           @default(0)
  taxRate           Float           @default(0)
  amount            Float
  createdAt         DateTime        @default(now())
}
