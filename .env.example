# Google OAuth 2.0 Credentials
# Create a Desktop OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
REDIRECT_URI=http://localhost

# Database (used by Prisma CLI — prisma studio, prisma migrate, etc.)
DATABASE_URL=file:./neuinvoicing.db
