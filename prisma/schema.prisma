// Prisma schema for neuInvoicing

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Company Information (Singleton - only one record)
model Company {
  id              String   @id @default(cuid())
  name            String
  address         String
  phone           String?
  email           String?
  taxId           String? // GSTIN, VAT, etc.
  logoPath        String?
  signaturePath   String?
  fiscalYearStart Int      @default(4) // Month (1-12), default April
  currency        String   @default("USD")
  invoicePrefix   String   @default("INV")
  termsConditions String?
  bankDetails     String?
  // GST-specific fields
  stateCode       String? // 2-digit state code (e.g., "27" for Maharashtra)
  stateName       String? // State name
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Customers and Suppliers
model Party {
  id              String    @id @default(cuid())
  name            String
  type            String // CUSTOMER or SUPPLIER
  phone           String?
  email           String?
  billingAddress  String?
  shippingAddress String?
  taxId           String? // GSTIN
  openingBalance  Float     @default(0)
  currentBalance  Float     @default(0)
  // GST-specific fields
  stateCode       String? // 2-digit state code
  stateName       String? // State name
  gstType         String    @default("REGULAR") // REGULAR, COMPOSITION, UNREGISTERED, CONSUMER, SEZ, DEEMED_EXPORT
  // Additional GST lookup fields
  legalName       String? // Official registered name from GST
  tradeName       String? // Trade name from GST
  gstStatus       String? // Active, Cancelled, Suspended
  city            String?
  district        String?
  pincode         String?
  fetchedFromGst  Boolean   @default(false)
  lastGstFetch    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  salesInvoices    SalesInvoice[]
  proformaInvoices ProformaInvoice[]
  purchaseBills    PurchaseBill[]
  payments         PaymentTransaction[]
  deliveryChallans DeliveryChallan[]
  creditDebitNotes CreditDebitNote[]
}

// Items (Products and Services)
model Item {
  id              String   @id @default(cuid())
  name            String
  skuHsn          String? // SKU code
  hsnCode         String? // HSN/SAC code for GST
  type            String   @default("PRODUCT") // PRODUCT or SERVICE
  unit            String   @default("pcs") // pcs, kg, hrs, etc.
  salePrice       Float    @default(0)
  purchasePrice   Float    @default(0)
  taxRate         Float    @default(0) // Total GST percentage (e.g., 18 for 18% GST)
  // GST tax type
  gstType         String   @default("GST") // GST, EXEMPT, NIL_RATED, NON_GST
  trackStock      Boolean  @default(false)
  currentStock    Float    @default(0)
  lowStockWarning Float    @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  salesInvoiceItems    SalesInvoiceItem[]
  proformaInvoiceItems ProformaInvoiceItem[]
  purchaseBillItems    PurchaseBillItem[]
  stockMovements       StockMovement[]
  deliveryChallanItems DeliveryChallanItem[]
  creditDebitNoteItems CreditDebitNoteItem[]
}

// Sales Invoices and Quotations
model SalesInvoice {
  id                   String         @id @default(cuid())
  invoiceNumber        String         @unique
  invoiceDate          DateTime       @default(now())
  type                 String         @default("INVOICE") // INVOICE or QUOTATION
  partyId              String
  party                Party          @relation(fields: [partyId], references: [id])
  subtotal             Float          @default(0)
  discount             Float          @default(0)
  taxAmount            Float          @default(0)
  totalAmount          Float          @default(0)
  amountPaid           Float          @default(0)
  balanceDue           Float          @default(0)
  status               String         @default("DRAFT") // DRAFT, PAID, PARTIAL, OVERDUE
  convertedFromQuoteId String?
  convertedQuote       SalesInvoice?  @relation("QuoteConversion", fields: [convertedFromQuoteId], references: [id])
  convertedInvoices    SalesInvoice[] @relation("QuoteConversion")
  convertedFromProformaId String?
  convertedProforma       ProformaInvoice? @relation("ProformaConversion", fields: [convertedFromProformaId], references: [id], onDelete: SetNull)
  notes                String?
  // GST-specific fields
  placeOfSupply        String? // State code of place of supply
  placeOfSupplyName    String? // State name of place of supply
  isInterState         Boolean        @default(false) // true = IGST, false = CGST+SGST
  reverseCharge        Boolean        @default(false) // Reverse charge mechanism
  cgstAmount           Float          @default(0)
  sgstAmount           Float          @default(0)
  igstAmount           Float          @default(0)
  cessAmount           Float          @default(0)
  // Supply type for GSTR classification
  supplyType           String         @default("B2B") // B2B, B2C_LARGE, B2C_SMALL, EXPORT, NIL_EXEMPT
  ecommerceGstin       String? // E-commerce operator GSTIN if applicable
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  dueDate           DateTime?
  // Additional fields (all optional)
  poNumber          String?
  ewayBillNo        String?
  vehicleNumber     String?
  warrantyPeriod    String?
  dispatchedThrough String?
  // Relations
  items            SalesInvoiceItem[]
  payments         PaymentTransaction[]
  creditDebitNotes CreditDebitNote[]
}

// Line items for sales invoices
model SalesInvoiceItem {
  id             String       @id @default(cuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  quantity       Float
  rate           Float
  discount       Float        @default(0)
  taxRate        Float        @default(0)
  total          Float
  // GST-specific fields
  hsnCode        String?
  taxableAmount  Float        @default(0)
  cgstRate       Float        @default(0)
  cgstAmount     Float        @default(0)
  sgstRate       Float        @default(0)
  sgstAmount     Float        @default(0)
  igstRate       Float        @default(0)
  igstAmount     Float        @default(0)
  cessRate       Float        @default(0)
  cessAmount     Float        @default(0)
  createdAt      DateTime     @default(now())
}

// Proforma Invoices
model ProformaInvoice {
  id                     String             @id @default(cuid())
  invoiceNumber          String             @unique
  invoiceDate            DateTime           @default(now())
  dueDate                DateTime?
  partyId                String
  party                  Party              @relation(fields: [partyId], references: [id])
  subtotal               Float              @default(0)
  discount               Float              @default(0)
  taxAmount              Float              @default(0)
  totalAmount            Float              @default(0)
  status                 String             @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  notes                  String?
  placeOfSupply          String?
  placeOfSupplyName      String?
  isInterState           Boolean            @default(false)
  reverseCharge          Boolean            @default(false)
  cgstAmount             Float              @default(0)
  sgstAmount             Float              @default(0)
  igstAmount             Float              @default(0)
  cessAmount             Float              @default(0)
  supplyType             String             @default("B2B")
  ecommerceGstin         String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deliveryTime           DateTime?

  items                  ProformaInvoiceItem[]
  convertedInvoices      SalesInvoice[]     @relation("ProformaConversion")
}

model ProformaInvoiceItem {
  id                String           @id @default(cuid())
  proformaInvoiceId String
  proformaInvoice   ProformaInvoice  @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item             @relation(fields: [itemId], references: [id])
  quantity          Float
  rate              Float
  discount          Float            @default(0)
  taxRate           Float            @default(0)
  total             Float
  hsnCode           String?
  taxableAmount     Float            @default(0)
  cgstRate          Float            @default(0)
  cgstAmount        Float            @default(0)
  sgstRate          Float            @default(0)
  sgstAmount        Float            @default(0)
  igstRate          Float            @default(0)
  igstAmount        Float            @default(0)
  cessRate          Float            @default(0)
  cessAmount        Float            @default(0)
  createdAt         DateTime         @default(now())
}

// Purchase Bills
model PurchaseBill {
  id                    String    @id @default(cuid())
  billNumber            String    @unique
  billDate              DateTime  @default(now())
  partyId               String
  party                 Party     @relation(fields: [partyId], references: [id])
  subtotal              Float     @default(0)
  discount              Float     @default(0)
  taxAmount             Float     @default(0)
  totalAmount           Float     @default(0)
  amountPaid            Float     @default(0)
  balanceDue            Float     @default(0)
  status                String    @default("DRAFT") // DRAFT, PAID, PARTIAL, OVERDUE
  notes                 String?
  // GST-specific fields
  placeOfSupply         String? // State code of place of supply
  placeOfSupplyName     String? // State name
  isInterState          Boolean   @default(false)
  reverseCharge         Boolean   @default(false)
  cgstAmount            Float     @default(0)
  sgstAmount            Float     @default(0)
  igstAmount            Float     @default(0)
  cessAmount            Float     @default(0)
  supplierInvoiceNumber String? // Supplier's invoice number
  supplierInvoiceDate   DateTime? // Supplier's invoice date
  itcEligibility        String    @default("ELIGIBLE") // ELIGIBLE, INELIGIBLE, PARTIAL
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  items    PurchaseBillItem[]
  payments PaymentTransaction[]
}

// Line items for purchase bills
model PurchaseBillItem {
  id             String       @id @default(cuid())
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  quantity       Float
  rate           Float
  discount       Float        @default(0)
  taxRate        Float        @default(0)
  total          Float
  // GST-specific fields
  hsnCode        String?
  taxableAmount  Float        @default(0)
  cgstRate       Float        @default(0)
  cgstAmount     Float        @default(0)
  sgstRate       Float        @default(0)
  sgstAmount     Float        @default(0)
  igstRate       Float        @default(0)
  igstAmount     Float        @default(0)
  cessRate       Float        @default(0)
  cessAmount     Float        @default(0)
  createdAt      DateTime     @default(now())
}

// Payment Transactions (Payment In and Payment Out)
model PaymentTransaction {
  id             String        @id @default(cuid())
  type           String // PAYMENT_IN or PAYMENT_OUT
  partyId        String
  party          Party         @relation(fields: [partyId], references: [id])
  amount         Float
  paymentMode    String        @default("CASH") // CASH, BANK_TRANSFER, CARD, CHEQUE, UPI, OTHER
  paymentDate    DateTime      @default(now())
  referenceType  String? // INVOICE, BILL, or ADVANCE
  referenceId    String? // ID of the invoice or bill (deprecated, use salesInvoiceId or purchaseBillId)
  salesInvoiceId String?
  salesInvoice   SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  purchaseBillId String?
  purchaseBill   PurchaseBill? @relation(fields: [purchaseBillId], references: [id])
  notes          String?
  createdAt      DateTime      @default(now())
}

// Stock Movement Audit Log
model StockMovement {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  movementType  String // SALE, PURCHASE, ADJUSTMENT
  quantity      Float // Positive for IN, Negative for OUT
  referenceType String? // "INVOICE", "BILL", "ADJUSTMENT"
  referenceId   String?
  notes         String?
  createdAt     DateTime @default(now())
}

// Sync Metadata
model SyncMetadata {
  id                    String    @id @default(cuid())
  lastSyncTimestamp     DateTime  @default(now())
  deviceId              String
  syncStatus            String    @default("idle") // idle, syncing, error
  cloudFileModifiedTime DateTime?
  lastError             String?
  updatedAt             DateTime  @updatedAt
}

// User Settings
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Delivery Challan (goods dispatch without invoice)
model DeliveryChallan {
  id                   String                @id @default(cuid())
  challanNumber        String                @unique
  challanDate          DateTime              @default(now())
  partyId              String
  party                Party                 @relation(fields: [partyId], references: [id])
  subtotal             Float                 @default(0)
  taxAmount            Float                 @default(0)
  totalAmount          Float                 @default(0)
  transportMode        String?
  vehicleNumber        String?
  notes                String?
  status               String                @default("PENDING") // PENDING, DELIVERED, CONVERTED
  convertedToInvoiceId String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  // Additional fields (all optional)
  poNumber             String?
  ewayBillNo           String?
  warrantyPeriod       String?
  dispatchedThrough    String?
  items                DeliveryChallanItem[]
}

model DeliveryChallanItem {
  id                String          @id @default(cuid())
  deliveryChallanId String
  deliveryChallan   DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  quantity          Float
  rate              Float
  taxRate           Float           @default(0)
  discount          Float           @default(0)
  total             Float
  hsnCode           String?
  createdAt         DateTime        @default(now())
}

// Credit and Debit Notes (for returns / adjustments)
model CreditDebitNote {
  id                 String                @id @default(cuid())
  noteNumber         String                @unique
  noteDate           DateTime              @default(now())
  type               String // CREDIT_NOTE or DEBIT_NOTE
  partyId            String
  party              Party                 @relation(fields: [partyId], references: [id])
  referenceInvoiceId String?
  referenceInvoice   SalesInvoice?         @relation(fields: [referenceInvoiceId], references: [id])
  reason             String?
  subtotal           Float                 @default(0)
  taxAmount          Float                 @default(0)
  totalAmount        Float                 @default(0)
  cgstAmount         Float                 @default(0)
  sgstAmount         Float                 @default(0)
  igstAmount         Float                 @default(0)
  isInterState       Boolean               @default(false)
  status             String                @default("ACTIVE") // ACTIVE, CANCELLED
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  items              CreditDebitNoteItem[]
}

model CreditDebitNoteItem {
  id                String          @id @default(cuid())
  creditDebitNoteId String
  creditDebitNote   CreditDebitNote @relation(fields: [creditDebitNoteId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  quantity          Float
  rate              Float
  discount          Float           @default(0)
  taxRate           Float           @default(0)
  total             Float
  hsnCode           String?
  taxableAmount     Float           @default(0)
  cgstRate          Float           @default(0)
  cgstAmount        Float           @default(0)
  sgstRate          Float           @default(0)
  sgstAmount        Float           @default(0)
  igstRate          Float           @default(0)
  igstAmount        Float           @default(0)
  createdAt         DateTime        @default(now())
}

// Cash & Bank Accounts
model BankAccount {
  id             String   @id @default(cuid())
  name           String
  type           String // CASH or BANK
  accountNumber  String?
  bankName       String?
  ifscCode       String?
  currentBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// GST Lookup Cache - Stores fetched GST details to minimize API calls
model GstCache {
  id                  String   @id @default(cuid())
  gstin               String   @unique
  tradeName           String?
  legalName           String?
  gstStatus           String? // Active, Cancelled, Suspended
  registrationDate    String?
  businessType        String?
  // Principal Address
  addressLine1        String?
  addressLine2        String?
  city                String?
  district            String?
  state               String?
  stateCode           String?
  pincode             String?
  // Raw response for additional addresses
  additionalAddresses String? // JSON stringified array
  rawResponse         String? // Full API response as JSON
  fetchedAt           DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
